  "presetExtra": {
    "Request Review": "請求審查",
    "Auto": "自動"
  },
  "patterns": [
    {
      "id": "twAddShortcut",
      "pattern": "^Add shortcut for (.+)$",
      "template": "為「{1}」新增快捷鍵",
      "replace": {
        "1": "twAction"
      },
      "sample": "Add shortcut for Close Tab"
    },
    {
      "id": "twRemoveShortcut",
      "pattern": "^Remove shortcut (.+?) for (.+)$",
      "template": "移除「{2}」的快捷鍵 {1}",
      "replace": {
        "2": "twAction"
      },
      "sample": "Remove shortcut Ctrl+W for Close Tab"
    },
    {
      "id": "twShortcut",
      "pattern": "^Shortcut (.+?) for (.+)$",
      "template": "「{2}」的快捷鍵：{1}",
      "replace": {
        "2": "twAction"
      },
      "sample": "Shortcut Ctrl+W for Close Tab"
    },
    {
      "id": "twPermPreset",
      "pattern": "^Agent permissions preset selector, current: (.+)$",
      "template": "代理權限預設選擇器，目前：{1}",
      "replace": {
        "1": "preset"
      },
      "sample": "Agent permissions preset selector, current: Request Review"
    },
    {
      "id": "twGreeting",
      "pattern": "^Good to see you, (.+)\\. What's next\\?$",
      "template": "{1}，很高興見到你。接下來要做什麼？",
      "sample": "Good to see you, Alex. What's next?"
    },
    {
      "id": "twWeeklyLimit",
      "pattern": "^(.+) Weekly Limit$",
      "template": "{1} 每週額度",
      "sample": "Gemini 4 Argon Weekly Limit"
    },
    {
      "id": "twMonthsAgo",
      "pattern": "^(\\d+)mo$",
      "template": "{1} 個月",
      "sample": "6mo"
    },
    {
      "id": "twWelcomeBack",
      "pattern": "^Welcome back, (.+)\\. Where should we pick up\\?$",
      "template": "歡迎回來，{1}。要從哪裡繼續？",
      "sample": "Welcome back, alex. Where should we pick up?"
    },
    {
      "id": "twModelLevel",
      "pattern": "^(.+) \\((Low|Medium|High)\\)$",
      "template": "{1}（{2}）",
      "replace": {
        "2": "twLevel"
      },
      "sample": "GPT-OSS 120B (Medium)"
    }
  ],
  "levels": {
    "Low": "低",
    "Medium": "中",
    "High": "高"
  }
}
