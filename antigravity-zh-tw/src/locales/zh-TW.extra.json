  "presetExtra": {
    "Request Review": "請求審查",
    "Auto": "自動"
  },
  "patterns": [
    {
      "id": "twAddShortcut",
      "pattern": "^Add shortcut for (.+)$",
      "template": "為「{1}」新增快捷鍵",
      "replace": {
        "1": "twAction"
      },
      "sample": "Add shortcut for Close Tab"
    },
    {
      "id": "twRemoveShortcut",
      "pattern": "^Remove shortcut (.+?) for (.+)$",
      "template": "移除「{2}」的快捷鍵 {1}",
      "replace": {
        "2": "twAction"
      },
      "sample": "Remove shortcut Ctrl+W for Close Tab"
    },
    {
      "id": "twShortcut",
      "pattern": "^Shortcut (.+?) for (.+)$",
      "template": "「{2}」的快捷鍵：{1}",
      "replace": {
        "2": "twAction"
      },
      "sample": "Shortcut Ctrl+W for Close Tab"
    },
    {
      "id": "twPermPreset",
      "pattern": "^Agent permissions preset selector, current: (.+)$",
      "template": "代理權限預設選擇器，目前：{1}",
      "replace": {
        "1": "preset"
      },
      "sample": "Agent permissions preset selector, current: Request Review"
    },
    {
      "id": "twGreeting",
      "pattern": "^Good to see you, (.+)\\. What's next\\?$",
      "template": "{1}，很高興見到你。接下來要做什麼？",
      "sample": "Good to see you, Alex. What's next?"
    },
    {
      "id": "twWeeklyLimit",
      "pattern": "^(.+) Weekly Limit$",
      "template": "{1} 每週額度",
      "sample": "Gemini 4 Argon Weekly Limit"
    },
    {
      "id": "twMonthsAgo",
      "pattern": "^(\\d+)mo$",
      "template": "{1} 個月",
      "sample": "6mo"
    },
    {
      "id": "twWelcomeBack",
      "pattern": "^Welcome back, (.+)\\. Where should we pick up\\?$",
      "template": "歡迎回來，{1}。要從哪裡繼續？",
      "sample": "Welcome back, alex. Where should we pick up?"
    },
    {
      "id": "twModelLevel",
      "pattern": "^(.+) \\((Low|Medium|High)\\)$",
      "template": "{1}（{2}）",
      "replace": {
        "2": "twLevel"
      },
      "sample": "GPT-OSS 120B (Medium)"
    },
    {
      "id": "twTurnOf",
      "pattern": "^Turn (\\d+) of (\\d+)$",
      "template": "第 {1} / {2} 輪",
      "sample": "Turn 1 of 11"
    },
    {
      "id": "twMinutesAgo",
      "pattern": "^(\\d+)m ago$",
      "template": "{1} 分鐘前",
      "sample": "28m ago"
    },
    {
      "id": "twHoursAgo",
      "pattern": "^(\\d+)h ago$",
      "template": "{1} 小時前",
      "sample": "3h ago"
    },
    {
      "id": "twDaysAgo",
      "pattern": "^(\\d+)d ago$",
      "template": "{1} 天前",
      "sample": "2d ago"
    },
    {
      "id": "twSecondsAgo",
      "pattern": "^(\\d+)s ago$",
      "template": "{1} 秒前",
      "sample": "15s ago"
    },
    {
      "id": "twAgentFinishedSummary",
      "pattern": "^Agent finished: ([\\s\\S]+)$",
      "template": "代理已完成：{1}",
      "sample": "Agent finished: Fixed the bug"
    },
    {
      "id": "twNotifCommand",
      "pattern": "^Command: ([\\s\\S]+)$",
      "template": "指令：{1}",
      "sample": "Command: git status"
    },
    {
      "id": "twNotifUrl",
      "pattern": "^URL: ([\\s\\S]+)$",
      "template": "網址：{1}",
      "sample": "URL: https://example.com"
    },
    {
      "id": "twAllowAction",
      "pattern": "^Allow (.+)\\?$",
      "template": "允許{1}嗎？",
      "replace": {
        "1": "twPermTarget"
      },
      "sample": "Allow running this command?"
    },
    {
      "id": "twSaveRuleAlwaysAllow",
      "pattern": "^Save rule to always allow (.+)\\?$",
      "template": "儲存規則以永遠允許{1}嗎？",
      "replace": {
        "1": "twPermTarget"
      },
      "sample": "Save rule to always allow running this command?"
    },
    {
      "id": "twQuotaResetOn",
      "pattern": "^Your quota for (.+) will reset on (.+)\\. Switch to another available model to continue\\.$",
      "template": "你的 {1} 額度將於 {2} 重置。請切換至其他可用模型以繼續。",
      "sample": "Your quota for Gemini will reset on 11/20. Switch to another available model to continue."
    },
    {
      "id": "twQuotaReachedSwitch",
      "pattern": "^Your quota for (.+) has been reached\\. Switch to another available model to continue\\.$",
